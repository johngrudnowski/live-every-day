DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_every_day
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
CORS_ORIGIN=http://localhost:3001,http://localhost:19006
VITE_API_URL=http://localhost:3000

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:19006

# OAuth providers (configure at least one)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloud SQL example (proxy on localhost:5432):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/live_every_day
# DB_SSL=false
#
# Cloud SQL direct TLS example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
