# Copy to android-keystore.properties in this directory and fill in real values.
# Keep this file outside android/ because android/ is generated by Expo prebuild.
# Generate a keystore (example):
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore apps/mobile/android-upload.keystore \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile: absolute path, or path relative to android/app/
storeFile=../../android-upload.keystore
storePassword=
keyPassword=
keyAlias=upload
