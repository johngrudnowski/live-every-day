    "build": "nest build",
    "dev": "pnpm start:dev",
    "format": "oxfmt --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --deny-warnings --node-plugin --vitest-plugin src --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --deny-warnings --node-plugin --vitest-plugin --fix src --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --run"
  },
