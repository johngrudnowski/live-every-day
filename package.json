{
  "name": "live-every-day",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "build:web": "turbo run build --filter=web",
    "build:db": "turbo run build --filter=database",
    "docker:build:api": "API_IMAGE_TAG=${API_IMAGE_TAG:-live-every-day-api:local} docker build --pull -f docker/api.Dockerfile -t \"$API_IMAGE_TAG\" .",
    "generate": "turbo run generate",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run check-types",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:mobile:go": "pnpm --filter mobile start:go",
    "mobile:prebuild:android": "pnpm --filter mobile prebuild:android",
    "mobile:build:android": "pnpm --filter mobile build:android:release",
    "mobile:build:android:no-prebuild": "pnpm --filter mobile build:android:release:no-prebuild",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check-types": "turbo run check-types",
    "infra:preview": "pnpm --dir infra stack:preview",
    "infra:up": "pnpm --dir infra stack:deploy",
    "infra:deploy": "pnpm --dir infra stack:deploy",
    "infra:destroy": "pnpm --dir infra destroy",
    "infra:typecheck": "pnpm --dir infra typecheck",
    "infra:publish:api": "pnpm --dir infra publish:api",
    "infra:migrate:api": "pnpm --dir infra migrate:api",
    "infra:deploy:api": "pnpm --dir infra deploy:api",
    "infra:release:api": "pnpm --dir infra release:api",
    "check-types:db": "turbo run check-types --filter=database",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "turbo run db:generate --filter=database",
    "db:migrate": "turbo run db:migrate --filter=database",
    "db:migrate:prod": "pnpm --filter database db:migrate:prod",
    "db:seed": "pnpm --filter database seed",
    "db:studio": "turbo run db:studio --filter=database"
  },
  "devDependencies": {
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "turbo": "^2.9.12",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
